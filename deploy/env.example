# Modelo do .env da produção na VPS (docs/08-infra-deploy.md): /opt/orco/production/.env, com
# `chmod 600` (só o usuário deploy lê). Sem staging desde 2026-10-21 (ADR-0017).
# Nunca commite valores reais.
#
# Senhas: gere cada uma com `openssl rand -hex 32`. Só letras e números, porque as do banco entram
# nas URLs de conexão montadas pelo compose.yaml.

# --- Ambiente ---
APP_ENV=production
# Endereço público (base dos links de e-mail)
SITE_URL=https://orco.nbbrdev.com
# Porta local do app, alcançada só pelo Nginx
APP_PORT=3000

# --- Banco (Postgres da produção) ---
# Porta do banco só dentro da VPS (127.0.0.1), para o backup pelo DBeaver via túnel SSH
DB_PORT=5433
# Superusuário: inicialização e backup pelo DBeaver. O app nunca o usa.
POSTGRES_PASSWORD=
# Roles do Orçô (db/bootstrap/roles.sql), criadas na primeira subida do banco
ORCO_OWNER_PASSWORD=
APP_USER_PASSWORD=
APP_AUTH_PASSWORD=

# --- Login (Better Auth) ---
# Assina cookies de sessão e tokens. Um por ambiente (openssl rand -hex 32). Trocar desloga todo mundo.
BETTER_AUTH_SECRET=
# Login com Google: o cliente OAuth deste ambiente no Google Cloud (deploy/README.md, "Login com Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Arquivos (RustFS do próprio ambiente) ---
S3_BUCKET=logos
# Usuário e senha do RustFS: o compose usa os mesmos valores no RustFS e no app
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-mail por SMTP (Resend), configurado na M2 ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM="Orçô <nao-responda@orco.nbbrdev.com>"

# --- Push (Web Push, NBB-61): um par de chaves deste ambiente ---
# Gere com `npx web-push generate-vapid-keys`. Sem as três, o push fica desligado. Trocar as chaves
# invalida as assinaturas dos aparelhos (cada pessoa liga de novo no perfil).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# O endereço deste ambiente (ex.: https://orco.nbbrdev.com)
VAPID_SUBJECT=

# --- Agendamento diário (NBB-62): senha da rota /api/cron/diario, que o daily.sh manda ---
# Gere com `openssl rand -hex 32`, uma por ambiente. Sem ela, a rota responde 503.
CRON_SECRET=
