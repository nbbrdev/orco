# Copie para .env.local e preencha. Nunca commite valores reais.
# Referência: docs/06-regras-dev.md §8. Na VPS, cada ambiente tem o seu /opt/orco/<ambiente>/.env
# (modelo: deploy/env.example).

# --- Ambiente e endereço ---
# development | staging | production
APP_ENV=development
# Base dos links de e-mail
SITE_URL=http://localhost:3000

# --- Banco: uma conexão por role (valores locais do compose.dev.yaml, senhas fictícias) ---
# app_user: tabelas do produto, sempre com RLS
DATABASE_URL_APP=postgres://app_user:app_user_dev@127.0.0.1:55432/orco
# app_auth: só as tabelas de login
DATABASE_URL_AUTH=postgres://app_auth:app_auth_dev@127.0.0.1:55432/orco
# orco_owner: só as migrations
DATABASE_URL_OWNER=postgres://orco_owner:orco_owner_dev@127.0.0.1:55432/orco

# --- Login (Better Auth) ---
# Assina cookies de sessão e tokens. O valor abaixo é fictício, só para o desenvolvimento local; na
# VPS, cada ambiente tem o seu (openssl rand -hex 32).
BETTER_AUTH_SECRET=dev-only-better-auth-secret-not-for-production
# Login com Google: obrigatório (o app não sobe sem). Use o cliente OAuth "local" do Google Cloud,
# com o retorno http://localhost:3000/api/auth/callback/google (deploy/README.md, "Login com Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Arquivos: RustFS, compatível com S3 (valores locais do compose.dev.yaml) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=logos
S3_ACCESS_KEY_ID=orco_dev
S3_SECRET_ACCESS_KEY=orco_dev_secret

# --- E-mail por SMTP: localmente o Mailpit (http://localhost:8025); na nuvem, o Resend ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Orçô <nao-responda@orco.nbbrdev.com>"

# --- Cadastro: teto diário de e-mails (RN-46) ---
# Sem a variável, 60. Os testes E2E criam uma conta por teste e passariam do teto; por isso o valor
# alto aqui e no CI. Não existe na VPS: lá vale sempre o padrão (deploy/compose.yaml não repassa).
SIGN_UP_EMAILS_PER_DAY=1000

# --- Push (Web Push, NBB-61): um par de chaves por ambiente ---
# Gere com `npx web-push generate-vapid-keys`. Sem as três, o push fica desligado (o perfil avisa).
# A pública vai para o navegador pela página do perfil, lida aqui na hora (não no build).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato que o serviço de push pede: o endereço do site.
VAPID_SUBJECT=http://localhost:3000

# --- Agendamento diário (NBB-62): senha da rota /api/cron/diario ---
# Localmente, para testar com curl: `openssl rand -hex 32`. Sem ela, a rota responde 503.
CRON_SECRET=

# --- Somente no staging (APP_ENV=staging) ---
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
