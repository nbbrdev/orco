# Copie para .env.local e preencha. Nunca commite valores reais.
# Referência: docs/06-regras-dev.md §8. Na VPS, as mesmas variáveis ficam em /opt/orco/<ambiente>.env.

# --- Ambiente e endereço ---
# development | staging | production
APP_ENV=development
# Base dos links de e-mail
SITE_URL=http://localhost:3000

# --- Banco (NBB-68): uma conexão por role ---
# app_user: tabelas do produto, sempre com RLS
DATABASE_URL_APP=
# app_auth: só as tabelas de login
DATABASE_URL_AUTH=
# orco_owner: só as migrations
DATABASE_URL_OWNER=

# --- Login (M2) ---
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Arquivos: RustFS, compatível com S3 (NBB-68) ---
S3_ENDPOINT=
S3_BUCKET=logos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- E-mail por SMTP (M2): Mailpit local, Resend na nuvem ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Orçô <nao-responda@orco.nbbrdev.com>"

# --- Públicas (embutidas no build, visíveis no navegador) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Somente servidor ---
TURNSTILE_SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# --- Somente no staging (APP_ENV=staging) ---
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=
